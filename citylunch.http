  "email": "jean@citylunch.fr",
  "mot_de_passe": "o7FtEgWofXK2"
}

###

### POST — Login Sophie Martin
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "sophie.martin@citylunch.fr",
  "mot_de_passe": "fPN9jguBFle4"
}

###

### POST — Login Lucas Bernard
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "lucas.bernard@citylunch.fr",
  "mot_de_passe": "2aiKJqtbkbEt"
}

###

### POST — 401 : mauvais mot de passe
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "jean@citylunch.fr",
  "mot_de_passe": "mauvais_mdp"
}

